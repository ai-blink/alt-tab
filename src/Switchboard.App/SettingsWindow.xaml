<Window x:Class="Switchboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Switchboard.App"
        xmlns:models="clr-namespace:Switchboard.Core.Models;assembly=Switchboard.Core"
        xmlns:viewModels="clr-namespace:Switchboard.App.ViewModels"
        Title="{DynamicResource Settings.WindowTitle}"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <app:EnumEqualsConverter x:Key="EnumEqualsConverter" />

        <Style x:Key="SidebarTabStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter Property="Foreground" Value="{Binding TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding SegmentBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="Background" Value="{Binding SegmentBackground}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter Property="Foreground" Value="{Binding TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoteButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="Background" Value="{Binding SegmentBackground}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{Binding ShellBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{Binding HeaderBackground}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Settings.Heading}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Settings.Tagline}" TextWrapping="Wrap" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom"
                        Margin="0,18,0,0"
                        Padding="10"
                        Background="{Binding SegmentBackground}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{DynamicResource Settings.SavedStatus}" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Settings.SavedStatusDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <RadioButton Content="{DynamicResource Settings.Tab.Position}"
                                 GroupName="SettingsTab"
                                 IsChecked="{Binding SelectedSettingsTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Position}"
                                 Style="{StaticResource SidebarTabStyle}" />
                    <RadioButton Content="{DynamicResource Settings.Tab.Appearance}"
                                 GroupName="SettingsTab"
                                 IsChecked="{Binding SelectedSettingsTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Appearance}"
                                 Style="{StaticResource SidebarTabStyle}" />
                    <RadioButton Content="{DynamicResource Settings.Tab.Behavior}"
                                 GroupName="SettingsTab"
                                 IsChecked="{Binding SelectedSettingsTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Behavior}"
                                 Style="{StaticResource SidebarTabStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Width="30"
                        Height="30"
                        IsCancel="True"
                        Click="OnCloseClick"
                        Content="×"
                        FontSize="18"
                        ToolTip="{DynamicResource Settings.CloseTooltip}" />
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Settings.Heading}" />
                    <TextBlock FontSize="12" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Settings.Subtitle}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="PositionPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="{x:Static viewModels:SettingsTab.Position}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Padding="13" Background="{Binding AccentSoftBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Foreground="{Binding TextBrush}" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="{DynamicResource Position.HowItWorksLabel}" /><Run Text="{DynamicResource Position.HowItWorks}" /></TextBlock>
                        </Border>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Position.SavedHeading}" />
                                <Border Margin="0,8,0,0" Padding="13" Background="{Binding SegmentBackground}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{Binding SavedOverlayPositionLabel}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Position.SavedDetail}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Position.RemoteHeading}" />
                                <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Position.RemoteDetail}" />
                                <UniformGrid Columns="3" Rows="3">
                                    <Button Tag="TopLeft" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↖" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.TopLeft}" /></StackPanel></Button>
                                    <Button Tag="TopCenter" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↑" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.TopCenter}" /></StackPanel></Button>
                                    <Button Tag="TopRight" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↗" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.TopRight}" /></StackPanel></Button>
                                    <Button Tag="MiddleLeft" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="←" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.MiddleLeft}" /></StackPanel></Button>
                                    <Button Tag="Center" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="●" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.Center}" /></StackPanel></Button>
                                    <Button Tag="MiddleRight" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="→" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.MiddleRight}" /></StackPanel></Button>
                                    <Button Tag="BottomLeft" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↙" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.BottomLeft}" /></StackPanel></Button>
                                    <Button Tag="BottomCenter" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↓" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.BottomCenter}" /></StackPanel></Button>
                                    <Button Tag="BottomRight" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↘" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="{DynamicResource Position.Remote.BottomRight}" /></StackPanel></Button>
                                </UniformGrid>
                                <Button Margin="3,10,3,0" Padding="10,8" Click="OnReturnSavedClick" Content="{DynamicResource Position.ReturnSaved}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsTab}" Value="{x:Static viewModels:SettingsTab.Appearance}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Appearance.ScaleHeading}" />
                        <TextBlock Margin="0,4,0,10" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Appearance.ScaleDetail}" />
                        <WrapPanel>
                            <RadioButton Content="60%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Sixty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="70%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Seventy}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="80%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Eighty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="100%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hundred}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="125%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OneTwentyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="150%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OneFifty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="200%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TwoHundred}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                        <Separator Margin="0,14" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Appearance.ThumbnailHeading}" />
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Content="{DynamicResource Appearance.Thumbnail.Normal}" GroupName="ThumbnailScale" IsChecked="{Binding SelectedThumbnailScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Normal}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Appearance.Thumbnail.Large}" GroupName="ThumbnailScale" IsChecked="{Binding SelectedThumbnailScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Large}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Appearance.Thumbnail.ExtraLarge}" GroupName="ThumbnailScale" IsChecked="{Binding SelectedThumbnailScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ExtraLarge}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                        <Separator Margin="0,14" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Appearance.TitleScaleHeading}" />
                        <TextBlock Margin="0,4,0,10" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Appearance.TitleScaleDetail}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <RadioButton Content="80%" GroupName="WindowTitleScale" IsChecked="{Binding SelectedWindowTitleScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Eighty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="100%" GroupName="WindowTitleScale" IsChecked="{Binding SelectedWindowTitleScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hundred}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="125%" GroupName="WindowTitleScale" IsChecked="{Binding SelectedWindowTitleScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OneTwentyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="150%" GroupName="WindowTitleScale" IsChecked="{Binding SelectedWindowTitleScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OneFifty}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                        <Separator Margin="0,14" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Appearance.AppNameLengthHeading}" />
                        <TextBlock Margin="0,4,0,10" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Appearance.AppNameLengthDetail}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <RadioButton Content="{DynamicResource Appearance.AppNameLength.Five}" GroupName="AppNameLength" IsChecked="{Binding SelectedAppNameLengthPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Five}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Appearance.AppNameLength.Six}" GroupName="AppNameLength" IsChecked="{Binding SelectedAppNameLengthPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Six}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Appearance.AppNameLength.Seven}" GroupName="AppNameLength" IsChecked="{Binding SelectedAppNameLengthPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Seven}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                        <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Appearance.ThemeHeading}" />
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Content="{DynamicResource Appearance.Theme.Transparent}" GroupName="Appearance" IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Transparent}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Appearance.Theme.Dark}" GroupName="Appearance" IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dark}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Appearance.Theme.Light}" GroupName="Appearance" IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Light}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="25%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TwentyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="50%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Fifty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="75%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=SeventyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="90%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Ninety}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="BehaviorPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsTab}" Value="{x:Static viewModels:SettingsTab.Behavior}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Behavior.ElevatedHeading}" />
                        <CheckBox x:Name="ElevatedAutoStartCheckBox" Margin="0,10,0,0" Click="OnElevatedAutoStartClick" Content="{DynamicResource Behavior.ElevatedAutoStart}" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Behavior.ElevatedDetail}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,15" Orientation="Horizontal">
                            <TextBlock x:Name="ElevationStatusText" VerticalAlignment="Center" FontSize="11" Foreground="{Binding AccentBrush}" />
                            <Button x:Name="RestartElevatedButton" Margin="12,0,0,0" Padding="10,4" Click="OnRestartElevatedClick" Content="{DynamicResource Behavior.RestartElevated}" Visibility="Collapsed" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Behavior.AlwaysOnTop}" IsChecked="{Binding IsAlwaysOnTop}" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Margin="0,4,0,15" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Behavior.AlwaysOnTopDetail}" />
                        <CheckBox Content="{DynamicResource Behavior.Compact}" IsChecked="{Binding IsCompactOverlayEnabled}" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Margin="0,4,0,15" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Behavior.CompactDetail}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Behavior.SizingHeading}" />
                        <WrapPanel Margin="0,10,0,14"><RadioButton Content="{DynamicResource Behavior.Sizing.Auto}" GroupName="Sizing" IsChecked="{Binding SelectedSizingPolicy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Auto}" Style="{StaticResource ChoiceRadioStyle}" /><RadioButton Content="{DynamicResource Behavior.Sizing.Dense}" GroupName="Sizing" IsChecked="{Binding SelectedSizingPolicy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dense}" Style="{StaticResource ChoiceRadioStyle}" /></WrapPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Behavior.DefaultViewHeading}" />
                        <WrapPanel Margin="0,10,0,14"><RadioButton Content="{DynamicResource Main.View.Grid}" GroupName="DefaultView" IsChecked="{Binding DefaultViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Grid}" Style="{StaticResource ChoiceRadioStyle}" /><RadioButton Content="{DynamicResource Main.View.Compact}" GroupName="DefaultView" IsChecked="{Binding DefaultViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Compact}" Style="{StaticResource ChoiceRadioStyle}" /><RadioButton Content="{DynamicResource Main.View.List}" GroupName="DefaultView" IsChecked="{Binding DefaultViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=List}" Style="{StaticResource ChoiceRadioStyle}" /></WrapPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Behavior.HotkeyHeading}" />
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding HotkeyModifiers}" SelectedItem="{Binding SelectedFirstHotkeyModifier}" /><ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding HotkeyModifiers}" SelectedItem="{Binding SelectedSecondHotkeyModifier}" /><ComboBox Grid.Column="2" DisplayMemberPath="Label" ItemsSource="{Binding HotkeyKeyOptions}" SelectedValue="{Binding SelectedHotkeyKey}" SelectedValuePath="Value" /></Grid>
                        <TextBlock Margin="0,18,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{DynamicResource Behavior.LanguageHeading}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="{DynamicResource Behavior.LanguageDetail}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Content="{DynamicResource Behavior.Language.Auto}" GroupName="Language" IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Auto}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Behavior.Language.Korean}" GroupName="Language" IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Korean}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Behavior.Language.English}" GroupName="Language" IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=English}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Behavior.Language.SimplifiedChinese}" GroupName="Language" IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=SimplifiedChinese}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="{DynamicResource Behavior.Language.Japanese}" GroupName="Language" IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Japanese}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
