<Window x:Class="Switchboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Switchboard.App"
        xmlns:models="clr-namespace:Switchboard.Core.Models;assembly=Switchboard.Core"
        xmlns:viewModels="clr-namespace:Switchboard.App.ViewModels"
        Title="Switchboard 설정"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <app:EnumEqualsConverter x:Key="EnumEqualsConverter" />

        <Style x:Key="SidebarTabStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter Property="Foreground" Value="{Binding TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding SegmentBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="Background" Value="{Binding SegmentBackground}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter Property="Foreground" Value="{Binding TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoteButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="Background" Value="{Binding SegmentBackground}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{Binding AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{Binding AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{Binding ShellBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{Binding HeaderBackground}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="설정" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="Switchboard를 내 작업 방식에 맞춥니다" TextWrapping="Wrap" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom"
                        Margin="0,18,0,0"
                        Padding="10"
                        Background="{Binding SegmentBackground}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="● 변경 내용 저장됨" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{Binding MutedTextBrush}" Text="바꾼 값은 다음 실행에도 유지됩니다." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <RadioButton Content="⌖  위치와 이동"
                                 GroupName="SettingsTab"
                                 IsChecked="{Binding SelectedSettingsTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Position}"
                                 Style="{StaticResource SidebarTabStyle}" />
                    <RadioButton Content="◐  모양과 크기"
                                 GroupName="SettingsTab"
                                 IsChecked="{Binding SelectedSettingsTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Appearance}"
                                 Style="{StaticResource SidebarTabStyle}" />
                    <RadioButton Content="⌨  기본 동작"
                                 GroupName="SettingsTab"
                                 IsChecked="{Binding SelectedSettingsTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Behavior}"
                                 Style="{StaticResource SidebarTabStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Width="30"
                        Height="30"
                        IsCancel="True"
                        Click="OnCloseClick"
                        Content="×"
                        FontSize="18"
                        ToolTip="설정 닫기" />
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="설정" />
                    <TextBlock FontSize="12" Foreground="{Binding MutedTextBrush}" Text="표시 위치, 화면 크기, 기본 동작을 나눠 관리합니다." />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="PositionPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSettingsTab}" Value="{x:Static viewModels:SettingsTab.Position}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Padding="13" Background="{Binding AccentSoftBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Foreground="{Binding TextBrush}" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="기본 방식: " /><Run Text="전환창의 빈 공간을 드래그하면 위치가 바로 저장됩니다. 아래 리모컨은 한 번만 옮기는 도구입니다." /></TextBlock>
                        </Border>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="내가 저장한 위치" />
                                <Border Margin="0,8,0,0" Padding="13" Background="{Binding SegmentBackground}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" Text="{Binding SavedOverlayPositionLabel}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="창 크기나 보기 모드가 바뀌어도 가까운 모서리·가장자리 기준을 유지합니다." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="위치 리모컨" />
                                <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="한 번 이동 · 기본 위치는 바뀌지 않음" />
                                <UniformGrid Columns="3" Rows="3">
                                    <Button Tag="TopLeft" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↖" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="좌상" /></StackPanel></Button>
                                    <Button Tag="TopCenter" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↑" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="상단" /></StackPanel></Button>
                                    <Button Tag="TopRight" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↗" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="우상" /></StackPanel></Button>
                                    <Button Tag="MiddleLeft" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="←" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="좌측" /></StackPanel></Button>
                                    <Button Tag="Center" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="●" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="중앙" /></StackPanel></Button>
                                    <Button Tag="MiddleRight" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="→" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="우측" /></StackPanel></Button>
                                    <Button Tag="BottomLeft" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↙" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="좌하" /></StackPanel></Button>
                                    <Button Tag="BottomCenter" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↓" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="하단" /></StackPanel></Button>
                                    <Button Tag="BottomRight" Click="OnRemoteMoveClick" Style="{StaticResource RemoteButtonStyle}"><StackPanel><TextBlock HorizontalAlignment="Center" FontSize="17" Text="↘" /><TextBlock HorizontalAlignment="Center" FontSize="10" Text="우하" /></StackPanel></Button>
                                </UniformGrid>
                                <Button Margin="3,10,3,0" Padding="10,8" Click="OnReturnSavedClick" Content="저장한 위치로 돌아가기" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsTab}" Value="{x:Static viewModels:SettingsTab.Appearance}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="전체 배율" />
                        <TextBlock Margin="0,4,0,10" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="글자, 카드, 간격을 함께 키우거나 줄입니다." />
                        <WrapPanel>
                            <RadioButton Content="60%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Sixty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="70%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Seventy}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="80%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Eighty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="100%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Hundred}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="125%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OneTwentyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="150%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=OneFifty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="200%" GroupName="OverlayScale" IsChecked="{Binding SelectedOverlayScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TwoHundred}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                        <Separator Margin="0,14" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="미리 보기 크기" />
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Content="기본" GroupName="ThumbnailScale" IsChecked="{Binding SelectedThumbnailScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Normal}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="조금 크게" GroupName="ThumbnailScale" IsChecked="{Binding SelectedThumbnailScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Large}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="크게" GroupName="ThumbnailScale" IsChecked="{Binding SelectedThumbnailScalePreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ExtraLarge}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                        <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="화면 분위기와 투명도" />
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Content="반투명" GroupName="Appearance" IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Transparent}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="어둡게" GroupName="Appearance" IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dark}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="밝게" GroupName="Appearance" IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Light}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="25%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TwentyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="50%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Fifty}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="75%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=SeventyFive}" Style="{StaticResource ChoiceRadioStyle}" />
                            <RadioButton Content="90%" GroupName="OverlayOpacity" IsChecked="{Binding SelectedOverlayOpacityPreset, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Ninety}" Style="{StaticResource ChoiceRadioStyle}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="BehaviorPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsTab}" Value="{x:Static viewModels:SettingsTab.Behavior}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </StackPanel.Style>
                        <CheckBox Content="항상 위에 표시" IsChecked="{Binding IsAlwaysOnTop}" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Margin="0,4,0,15" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="전환창이 열려 있는 동안 다른 일반 창보다 앞에 표시합니다." />
                        <CheckBox Content="컴팩트 보기 사용" IsChecked="{Binding IsCompactOverlayEnabled}" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                        <TextBlock Margin="0,4,0,15" FontSize="11" Foreground="{Binding MutedTextBrush}" Text="화면 작업 영역을 작게 사용해 촘촘하게 표시합니다." />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="크기 정책" />
                        <WrapPanel Margin="0,10,0,14"><RadioButton Content="자동" GroupName="Sizing" IsChecked="{Binding SelectedSizingPolicy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Auto}" Style="{StaticResource ChoiceRadioStyle}" /><RadioButton Content="조밀" GroupName="Sizing" IsChecked="{Binding SelectedSizingPolicy, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dense}" Style="{StaticResource ChoiceRadioStyle}" /></WrapPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="기본 보기" />
                        <WrapPanel Margin="0,10,0,14"><RadioButton Content="격자" GroupName="DefaultView" IsChecked="{Binding DefaultViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Grid}" Style="{StaticResource ChoiceRadioStyle}" /><RadioButton Content="압축" GroupName="DefaultView" IsChecked="{Binding DefaultViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Compact}" Style="{StaticResource ChoiceRadioStyle}" /><RadioButton Content="목록" GroupName="DefaultView" IsChecked="{Binding DefaultViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=List}" Style="{StaticResource ChoiceRadioStyle}" /></WrapPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="단축키" />
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding HotkeyModifiers}" SelectedItem="{Binding SelectedFirstHotkeyModifier}" /><ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding HotkeyModifiers}" SelectedItem="{Binding SelectedSecondHotkeyModifier}" /><ComboBox Grid.Column="2" DisplayMemberPath="Label" ItemsSource="{Binding HotkeyKeyOptions}" SelectedValue="{Binding SelectedHotkeyKey}" SelectedValuePath="Value" /></Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
