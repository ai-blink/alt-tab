    <!-- Position & Move -->
    <sys:String x:Key="Position.HowItWorksLabel" xml:space="preserve">기본 방식: </sys:String>
    <sys:String x:Key="Position.HowItWorks">전환창의 빈 공간을 드래그하면 위치가 바로 저장됩니다. 아래 리모컨은 한 번만 옮기는 도구입니다.</sys:String>
