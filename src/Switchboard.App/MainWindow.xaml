<Window x:Class="Switchboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Switchboard.App"
        xmlns:models="clr-namespace:Switchboard.Core.Models;assembly=Switchboard.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Switchboard"
        Width="955"
        Height="540"
        MinWidth="0"
        MinHeight="0"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Topmost="{Binding IsAlwaysOnTop}"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <app:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <app:WindowIconConverter x:Key="WindowIconConverter" />
        <app:AppNameLabelConverter x:Key="AppNameLabelConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 24px target shown only on the hovered or selected card; hidden (not collapsed) so the title does not re-trim on hover. -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#CC252B35" />
            <Setter Property="BorderBrush" Value="#99AAB5C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DDE4EE" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Content" Value="&#xE8BB;" />
            <Setter Property="ToolTip" Value="{DynamicResource Main.CloseWindowTooltip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9C42B3A" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFF06A78" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFF06A78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GridWindowTemplate">
            <Border Width="{Binding DataContext.GridCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding DataContext.GridCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{Binding DataContext.CardBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderBrush="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid Background="{Binding ThumbnailBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="{Binding DataContext.SearchBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                          ClipToBounds="True">
                        <Rectangle Fill="{Binding ThumbnailBrush}"
                                   Opacity="0.32" />
                        <Rectangle Fill="{Binding DataContext.PreviewShadeBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Border Margin="9"
                                Background="#22FFFFFF"
                                BorderBrush="#36FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0.16"
                                Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="#E05A58" />
                                    <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="#E9BE55" />
                                    <Ellipse Width="5" Height="5" Fill="#4FC17A" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Opacity="0.8"
                                           Text="{Binding ThumbnailLabel}" />
                            </Grid>
                        </Border>
                        <app:DwmThumbnailPreview SourceHandle="{Binding Handle}"
                                                 IsPreviewVisible="{Binding DataContext.AreDwmThumbnailsVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#D80B0F16"
                            BorderBrush="#336C7A90"
                            BorderThickness="0,1,0,0"
                            Padding="8,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Handle, Converter={StaticResource WindowIconConverter}}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding DataContext.GridAppLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="SemiBold"
                                           Foreground="#B8C2D3"
                                           ToolTip="{Binding AppName}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource AppNameLabelConverter}">
                                            <Binding Path="AppName" />
                                            <Binding Path="Title" />
                                            <Binding Path="DataContext.AppNameMaxLength" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding DataContext.GridTitleLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#554AA3FF"
                                    CornerRadius="4"
                                    Padding="5,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#84C0FF"
                                           Text="ACTIVE" />
                            </Border>
                            <Button Grid.Column="3"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.CloseWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource WindowCloseButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CompactWindowTemplate">
            <Border Width="{Binding DataContext.CompactCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding DataContext.CompactCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{Binding DataContext.CardBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderBrush="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="{Binding DataContext.SearchBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                          ClipToBounds="True">
                        <Rectangle Fill="{Binding ThumbnailBrush}"
                                   Opacity="0.32" />
                        <Rectangle Fill="{Binding DataContext.PreviewShadeBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <app:DwmThumbnailPreview SourceHandle="{Binding Handle}"
                                                 IsPreviewVisible="{Binding DataContext.AreDwmThumbnailsVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#E20B0F16"
                            BorderBrush="#336C7A90"
                            BorderThickness="0,1,0,0"
                            Padding="7,3"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Width="14"
                                       Height="14"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Handle, Converter={StaticResource WindowIconConverter}}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding DataContext.CompactAppLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="SemiBold"
                                           Foreground="#B8C2D3"
                                           ToolTip="{Binding AppName}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource AppNameLabelConverter}">
                                            <Binding Path="AppName" />
                                            <Binding Path="Title" />
                                            <Binding Path="DataContext.AppNameMaxLength" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding DataContext.CompactTitleLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#554AA3FF"
                                    CornerRadius="4"
                                    Padding="4,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="#84C0FF"
                                           Text="ACTIVE" />
                            </Border>
                            <Button Grid.Column="3"
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.CloseWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource WindowCloseButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListWindowTemplate">
            <Border Width="{Binding DataContext.ListWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding DataContext.ListRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{Binding DataContext.CardBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderBrush="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="1"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Margin="7,6,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding DataContext.ListPreviewColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              Background="{Binding DataContext.SearchBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                              ClipToBounds="True">
                            <Rectangle Fill="{Binding ThumbnailBrush}"
                                       Opacity="0.32" />
                            <Rectangle Fill="{Binding DataContext.PreviewShadeBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <app:DwmThumbnailPreview SourceHandle="{Binding Handle}"
                                                     IsPreviewVisible="{Binding DataContext.AreDwmThumbnailsVisible, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>

                        <Grid Grid.Column="1"
                              Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0"
                                       VerticalAlignment="Center">
                                <Image DockPanel.Dock="Left"
                                       Width="20"
                                       Height="20"
                                       Margin="0,0,7,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Handle, Converter={StaticResource WindowIconConverter}}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{Binding DataContext.ListAppLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Text="{Binding AppName}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Grid.Row="1"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="9"
                                       Foreground="{Binding DataContext.MutedTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Text="{Binding Id}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1"
                          Margin="0,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="{Binding DataContext.ListTitleLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{Binding DataContext.MutedTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Column="1"
                                Width="54"
                                Height="18"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="#554AA3FF"
                                CornerRadius="4"
                                Padding="5,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="#84C0FF"
                                       Text="ACTIVE" />
                        </Border>
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.CloseWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource WindowCloseButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="WindowListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource WindowCardItemStyle}" />
            <Setter Property="ItemTemplate" Value="{StaticResource GridWindowTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GridColumnCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedViewMode}" Value="{x:Static models:SwitcherViewMode.Compact}">
                    <Setter Property="ItemTemplate" Value="{StaticResource CompactWindowTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedViewMode}" Value="{x:Static models:SwitcherViewMode.List}">
                    <Setter Property="ItemTemplate" Value="{StaticResource ListWindowTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A54A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                            <!-- Declared after hover so a checked control keeps its solid accent; translucent accent made white text unreadable on Light. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF1F6FD1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A54A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortMenuButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="{Binding SegmentBackground}" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                            <!-- Declared after hover so a checked control keeps its solid accent; translucent accent made white text unreadable on Light. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF1F6FD1" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Thick selection = 2px accent ring + 2px soft halo; same 4px footprint as before so layout math is unchanged. -->
                        <Border x:Name="SelectionHalo"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11">
                            <Border x:Name="SelectionFrame"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="9">
                                <ContentPresenter />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#8854A3FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#FF54A3FF" />
                                <Setter TargetName="SelectionFrame" Property="Background" Value="#3354A3FF" />
                                <Setter TargetName="SelectionHalo" Property="BorderBrush" Value="#6654A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18"
          PreviewMouseLeftButtonDown="OnWindowSurfaceMouseLeftButtonDown">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding PresentationScale}" ScaleY="{Binding PresentationScale}" />
        </Grid.LayoutTransform>

        <Border Background="{Binding ShellBackground}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="{Binding ShellShadowOpacity}"
                                  ShadowDepth="10"
                                  Color="#05070A" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{Binding HeaderBackground}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TextBrush}"
                                       Text="Switchboard" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{Binding WindowCountLabel}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Height="32"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{Binding SearchBackground}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{Binding MutedTextBrush}"
                                           Text="&#xE721;" />
                                <TextBlock Grid.Column="1"
                                           Margin="3,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{Binding MutedTextBrush}"
                                           IsHitTestVisible="False"
                                           Text="{DynamicResource Main.SearchPlaceholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Column="1"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{Binding TextBrush}"
                                         CaretBrush="{Binding AccentBrush}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Column="2"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Background="{Binding SegmentBackground}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{Binding MutedTextBrush}"
                                               Text="Ctrl+K" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Height="30"
                                    Margin="0,0,8,0"
                                    Background="{Binding SegmentBackground}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{DynamicResource Main.View.Grid}"
                                                 GroupName="ViewMode"
                                                 IsChecked="{Binding SelectedViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Grid}"
                                                 Style="{StaticResource ModeRadioStyle}" />
                                    <RadioButton Content="{DynamicResource Main.View.Compact}"
                                                 GroupName="ViewMode"
                                                 IsChecked="{Binding SelectedViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Compact}"
                                                 Style="{StaticResource ModeRadioStyle}" />
                                    <RadioButton Content="{DynamicResource Main.View.List}"
                                                 GroupName="ViewMode"
                                                 IsChecked="{Binding SelectedViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=List}"
                                                 Style="{StaticResource ModeRadioStyle}" />
                                </StackPanel>
                            </Border>


                            <Button x:Name="SortMenuButton"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="Sort windows"
                                    Click="OnSortMenuButtonClick"
                                    Style="{StaticResource SortMenuButtonStyle}"
                                    ToolTip="{DynamicResource Main.SortTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SortModeLabel}" />
                                    <TextBlock Margin="7,1,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE70D;" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="{DynamicResource Main.Sort.Recent}" Tag="Recent" Click="OnSortMenuItemClick" IsChecked="{Binding SelectedSortMode, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Recent}" />
                                        <MenuItem Header="{DynamicResource Main.Sort.App}" Tag="App" Click="OnSortMenuItemClick" IsChecked="{Binding SelectedSortMode, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=App}" />
                                        <MenuItem Header="{DynamicResource Main.Sort.Monitor}" Tag="Monitor" Click="OnSortMenuItemClick" IsChecked="{Binding SelectedSortMode, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Monitor}" />
                                        <MenuItem Header="{DynamicResource Main.Sort.Title}" Tag="Title" Click="OnSortMenuItemClick" IsChecked="{Binding SelectedSortMode, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Title}" />
                                        <MenuItem Header="{DynamicResource Main.Sort.Favorites}" Tag="Favorites" Click="OnSortMenuItemClick" IsChecked="{Binding SelectedSortMode, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Favorites}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button x:Name="SettingsButton"
                                    Content="&#xE713;"
                                    AutomationProperties.Name="Settings"
                                    Click="OnSettingsButtonClick"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="{DynamicResource Main.SettingsTooltip}" />
                            <ToggleButton Content="&#xE718;"
                                          AutomationProperties.Name="Always on top"
                                          IsChecked="{Binding IsAlwaysOnTop}"
                                          Margin="0,0,8,0"
                                          Style="{StaticResource ChromeToggleButtonStyle}"
                                          ToolTip="{DynamicResource Main.AlwaysOnTopTooltip}" />
                            <Button Content="&#xE72C;"
                                    Command="{Binding RefreshCommand}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="{DynamicResource Main.RefreshTooltip}" />
                            <Button Content="&#xE8BB;"
                                    Click="OnCloseClick"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="{DynamicResource Main.CloseTooltip}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="14,12,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Height="24"
                            Margin="4,0,4,6"
                            Background="{Binding SegmentBackground}"
                            BorderBrush="{Binding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedViewMode}" Value="{x:Static models:SwitcherViewMode.List}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.ListHeader.App1}" />
                            <TextBlock Grid.Column="1"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.ListHeader.Title1}" />
                            <TextBlock Grid.Column="2"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.ListHeader.App2}" />
                            <TextBlock Grid.Column="3"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.ListHeader.Title2}" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="WindowList"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleWindows}"
                             MouseDoubleClick="OnWindowListMouseDoubleClick"
                             SelectedItem="{Binding SelectedWindow}"
                             Style="{StaticResource WindowListStyle}" />
                </Grid>

                <Border Grid.Row="2"
                        Background="{Binding HeaderBackground}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,0">
                        <DockPanel LastChildFill="False"
                                   VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="0,0,16,0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.Hint.Tab}" />
                            <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,14,0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.Hint.Enter}" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{DynamicResource Main.Hint.Esc}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
