<Window x:Class="Switchboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Switchboard.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Switchboard"
        Width="860"
        Height="392"
        MinWidth="780"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <app:EnumEqualsConverter x:Key="EnumEqualsConverter" />

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{Binding BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A54A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4A54A3FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionFrame"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="9"
                                Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#6654A3FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#FF54A3FF" />
                                <Setter TargetName="SelectionFrame" Property="Background" Value="#2454A3FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="#FF54A3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="{Binding ShellBackground}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="1"
                CornerRadius="11"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="{Binding ShellShadowOpacity}"
                                  ShadowDepth="10"
                                  Color="#05070A" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{Binding HeaderBackground}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnChromeMouseLeftButtonDown"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="128" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TextBrush}"
                                       Text="Switchboard" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{Binding WindowCountLabel}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Height="32"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{Binding SearchBackground}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{Binding MutedTextBrush}"
                                           Text="&#xE721;" />
                                <TextBox Grid.Column="1"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{Binding TextBrush}"
                                         CaretBrush="{Binding AccentBrush}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Column="2"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Background="{Binding SegmentBackground}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{Binding MutedTextBrush}"
                                               Text="Ctrl+K" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Height="30"
                                    Margin="0,0,8,0"
                                    Background="{Binding SegmentBackground}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="투명"
                                                 GroupName="Appearance"
                                                 IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Transparent}"
                                                 Style="{StaticResource ModeRadioStyle}" />
                                    <RadioButton Content="다크"
                                                 GroupName="Appearance"
                                                 IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dark}"
                                                 Style="{StaticResource ModeRadioStyle}" />
                                    <RadioButton Content="라이트"
                                                 GroupName="Appearance"
                                                 IsChecked="{Binding SelectedAppearanceMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Light}"
                                                 Style="{StaticResource ModeRadioStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Width="74"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Background="{Binding SegmentBackground}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding MutedTextBrush}"
                                           Text="{Binding SelectedSortMode}" />
                            </Border>

                            <Button Content="&#xE72C;"
                                    Command="{Binding RefreshCommand}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="Refresh" />
                            <Button Content="&#xE8BB;"
                                    Click="OnCloseClick"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    ToolTip="Close" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="14,12,14,8">
                    <ListBox Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource WindowCardItemStyle}"
                             ItemsSource="{Binding VisibleWindows}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedWindow}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="258"
                                        Height="108"
                                        Background="{Binding DataContext.CardBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                        BorderBrush="{Binding DataContext.BorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              Background="{Binding ThumbnailBrush}">
                                            <Rectangle Fill="{Binding DataContext.PreviewShadeBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <app:DwmThumbnailPreview SourceHandle="{Binding Handle}" />
                                            <Border Margin="10"
                                                    Background="#28FFFFFF"
                                                    BorderBrush="#45FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Opacity="0.28"
                                                    Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="12" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="#E05A58" />
                                                        <Ellipse Width="5" Height="5" Margin="0,0,4,0" Fill="#E9BE55" />
                                                        <Ellipse Width="5" Height="5" Fill="#4FC17A" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="8" />
                                                            <RowDefinition Height="8" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0"
                                                                Width="48"
                                                                HorizontalAlignment="Left"
                                                                Background="{Binding DataContext.PreviewLineBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CornerRadius="3" />
                                                        <Border Grid.Row="1"
                                                                Width="62"
                                                                Margin="0,6,0,0"
                                                                HorizontalAlignment="Left"
                                                                Background="{Binding DataContext.PreviewLineBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CornerRadius="3"
                                                                Opacity="0.7" />
                                                        <TextBlock Grid.Row="2"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Bottom"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Opacity="0.9"
                                                                   Text="{Binding ThumbnailLabel}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="10,9,9,9">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Width="64"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.MutedTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Text="{Binding AppName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border DockPanel.Dock="Right"
                                                        Background="{Binding DataContext.AccentSoftBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CornerRadius="4"
                                                        Padding="5,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Text="ACTIVE" />
                                                </Border>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       LineHeight="17"
                                                       MaxHeight="35"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />

                                            <DockPanel Grid.Row="2">
                                                <TextBlock DockPanel.Dock="Left"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10"
                                                           Foreground="{Binding DataContext.MutedTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Text="{Binding MonitorName}" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="10"
                                                           Foreground="{Binding DataContext.MutedTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Text="{Binding ThumbnailLabel}" />
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Row="2"
                        Background="{Binding HeaderBackground}"
                        BorderBrush="{Binding BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,0">
                        <DockPanel LastChildFill="False"
                                   VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="0,0,16,0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="Tab cycle" />
                            <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,14,0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="Enter focus" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="10"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="Esc close" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
